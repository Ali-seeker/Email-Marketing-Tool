# ==============================================================================
# ColdReach - Environment Configuration Example
# Copy to .env and configure. NEVER commit .env to version control!
# ==============================================================================

# SAFE BY DEFAULT: Must remain false unless explicitly ready to send real emails
LIVE_MODE=false

# Application
APP_NAME=ColdReach
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite with WAL mode)
DATABASE_URL=sqlite:///data/coldreach.db

# Hard Safety Limits
MAX_EMAILS_PER_DAY_PER_MAILBOX=30
MIN_SECONDS_BETWEEN_EMAILS=120
BOUNCE_RATE_STOP_THRESHOLD_PERCENT=2.0

# SMTP Configuration (Used only when LIVE_MODE=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change_this_to_app_password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=user@example.com
SMTP_FROM_NAME="John Doe"

# IMAP Configuration (For incoming reply/bounce polling)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=user@example.com
IMAP_PASSWORD=change_this_to_app_password
IMAP_USE_SSL=true
